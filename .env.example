# =====================================================================
# .env.example - Barbershop (Docker Compose)
#
# Cara pakai:
#   1. Salin file ini menjadi .env  ->  cp .env.example .env
#   2. Ganti semua nilai "GANTI_..." dan isi APP_KEY
#   3. JANGAN commit file .env (berisi rahasia). Hanya .env.example yang di-commit.
#
# Catatan: hindari karakter  $  #  "  '  spasi pada password agar tidak
# disalahartikan oleh Docker Compose.
# =====================================================================

# --- Aplikasi ---------------------------------------------------------
APP_NAME=Barbershop
APP_ENV=production
APP_DEBUG=false

# Wajib diisi. Cara membuat key:
#   Linux / Azure VM : echo "base64:$(openssl rand -base64 32)"
#   Windows (CMD)    : docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# Alamat publik tanpa HTTPS. Ganti dengan IP publik VM Azure Anda.
# Contoh: APP_URL=http://20.198.10.5
APP_URL=http://localhost

# Port di host. Di Azure VM biarkan 80.
# Saat uji lokal dan XAMPP masih aktif, ganti ke 8080.
APP_PORT=80

# --- Database (MySQL) -------------------------------------------------
# DB_HOST dan DB_PORT diatur otomatis di compose.yaml (host = "database").
DB_DATABASE=barbershop
DB_USERNAME=barbershop
DB_PASSWORD=GANTI_PASSWORD_DATABASE
MYSQL_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_MYSQL

# --- Laravel ----------------------------------------------------------
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
MAIL_MAILER=log

# --- Otomatisasi saat container start ---------------------------------
RUN_MIGRATIONS=true
RUN_SEEDERS=true
SEEDER_CLASS=AdminSeeder

# --- Akun admin awal (dibuat oleh AdminSeeder) -------------------------
ADMIN_NAME=Admin Barbershop
ADMIN_EMAIL=admin@barbershop.test
ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN
